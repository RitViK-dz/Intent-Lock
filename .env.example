# Database storage path (SQLite)
DB_PATH=./intentlock.db

# Directory where generated Ed25519 cryptographic keys are stored
# IMPORTANT: Never commit files inside this directory to version control!
KEYS_DIR=./keys

# Token Time-To-Live in seconds (e.g., 300 = 5 minutes)
TOKEN_TTL_SECONDS=300

# Allowed clock skew window in seconds to tolerate slight differences between issuer and verifier clocks
CLOCK_SKEW_SECONDS=5

# Unique identifier for the mock merchant/store
STORE_ID=demo-store

# Demo mode toggle (enables simulation test endpoints like /api/demo/reset when true)
DEMO_MODE=false
